{
  "entities": {
    "DoctorProfile": {
      "title": "DoctorProfile",
      "description": "Doctor tenant account profile for independent medical practitioners in India",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Authenticated Firebase User UID"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique tenant slug or UID for practice isolation"
        },
        "fullName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Doctor full legal name with Dr. prefix"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "description": "Professional practice email address"
        },
        "mobile": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$",
          "description": "10-digit Indian mobile number"
        },
        "qualifications": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Medical qualifications/degrees (e.g. MBBS, MD)"
        },
        "specialization": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Primary medical specialization"
        },
        "customSpecialization": {
          "type": "string",
          "maxLength": 100,
          "description": "Custom specialization if Other selected"
        },
        "registrationCouncil": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "State medical council or NMC authority"
        },
        "registrationNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Medical council registration number"
        },
        "experienceYears": {
          "type": "string",
          "maxLength": 10,
          "description": "Years of clinical experience"
        },
        "languages": {
          "type": "string",
          "description": "Comma separated or serialized languages"
        },
        "bio": {
          "type": "string",
          "maxLength": 1000,
          "description": "Doctor profile description and clinical summary"
        },
        "clinicName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "description": "Primary practice location or clinic name"
        },
        "practiceType": {
          "type": "string",
          "enum": ["independent_clinic", "polyclinic", "hospital_opd", "nursing_home"],
          "description": "Facility type"
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Primary Indian practice city"
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Indian state or union territory"
        },
        "locality": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Locality or neighborhood"
        },
        "addressLine": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300,
          "description": "Full street address of clinic"
        },
        "landmark": {
          "type": "string",
          "maxLength": 150,
          "description": "Nearby landmark"
        },
        "pincode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[1-9][0-9]{5}$",
          "description": "6-digit Indian postal code"
        },
        "consultationFee": {
          "type": "string",
          "description": "Standard OPD consultation fee in INR"
        },
        "followUpFee": {
          "type": "string",
          "description": "Follow-up consultation fee in INR"
        },
        "followUpDays": {
          "type": "number",
          "description": "Days for valid follow-up window"
        },
        "clinicPhone": {
          "type": "string",
          "maxLength": 20,
          "description": "Reception desk telephone or landline"
        },
        "avgDurationMinutes": {
          "type": "number",
          "description": "Average consultation duration in minutes"
        },
        "locations": {
          "type": "array",
          "description": "List of practice locations and clinics managed by this doctor"
        },
        "consultationSettings": {
          "type": "object",
          "description": "Consultation fee, duration, modes, and emergency reserve configuration"
        },
        "bookingPreferences": {
          "type": "object",
          "description": "Queue token capacity, walk-in QR toggle, WhatsApp alert threshold, and booking windows"
        },
        "role": {
          "type": "string",
          "enum": ["doctor_owner"],
          "description": "Role in multi-tenant system"
        },
        "credentialsVerified": {
          "type": "boolean",
          "description": "Council credential verification flag (always false on initial self-registration)"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Cached email verification state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document modification server timestamp"
        }
      },
      "required": [
        "uid",
        "tenantId",
        "fullName",
        "email",
        "mobile",
        "qualifications",
        "specialization",
        "registrationCouncil",
        "registrationNumber",
        "clinicName",
        "practiceType",
        "city",
        "state",
        "locality",
        "addressLine",
        "pincode",
        "consultationFee",
        "role",
        "credentialsVerified",
        "createdAt"
      ]
    },
    "PublicDoctorProfile": {
      "title": "PublicDoctorProfile",
      "description": "Sanitized public profile for public patient discovery across Indian cities",
      "type": "object",
      "properties": {
        "doctorUid": {
          "type": "string",
          "description": "Doctor's Firebase UID"
        },
        "fullName": {
          "type": "string",
          "description": "Doctor's professional legal name"
        },
        "specialization": {
          "type": "string",
          "description": "Medical specialization"
        },
        "customSpecialization": {
          "type": "string",
          "description": "Custom specialization if Other"
        },
        "qualifications": {
          "type": "string",
          "description": "Degrees and credentials"
        },
        "experienceYears": {
          "type": "string",
          "description": "Years of experience"
        },
        "languages": {
          "type": "array",
          "description": "Languages spoken"
        },
        "bio": {
          "type": "string",
          "description": "Public professional biography"
        },
        "registrationCouncil": {
          "type": "string",
          "description": "Medical council authority"
        },
        "registrationNumber": {
          "type": "string",
          "description": "Council licence number"
        },
        "credentialsVerified": {
          "type": "boolean",
          "description": "State medical council verification flag"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "pending_review", "published", "suspended"],
          "description": "Publication lifecycle status"
        },
        "city": {
          "type": "string",
          "description": "Primary practice city"
        },
        "cities": {
          "type": "array",
          "description": "All cities where doctor operates active clinics"
        },
        "primaryClinicName": {
          "type": "string",
          "description": "Name of primary clinic"
        },
        "primaryAddress": {
          "type": "string",
          "description": "Address of primary clinic"
        },
        "primaryLocality": {
          "type": "string",
          "description": "Locality of primary clinic"
        },
        "primaryPincode": {
          "type": "string",
          "description": "PIN code of primary clinic"
        },
        "consultationFee": {
          "type": "string",
          "description": "Standard OPD consultation fee in INR"
        },
        "locations": {
          "type": "array",
          "description": "Active public practice locations"
        },
        "schedule": {
          "type": "object",
          "description": "OPD working schedule and sessions"
        },
        "bookingPreferences": {
          "type": "object",
          "description": "Public booking and walk-in rules"
        },
        "searchKeywords": {
          "type": "array",
          "description": "Tokens for client/Firestore search"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "doctorUid",
        "fullName",
        "specialization",
        "qualifications",
        "city",
        "cities",
        "primaryClinicName",
        "consultationFee",
        "status",
        "credentialsVerified"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Patient appointment booking record",
      "type": "object",
      "properties": {
        "appointmentId": { "type": "string", "description": "Unique appointment ID" },
        "bookingReference": { "type": "string", "description": "Human-friendly booking reference code" },
        "doctorUid": { "type": "string", "description": "Doctor UID" },
        "locationId": { "type": "string", "description": "Practice location ID" },
        "locationName": { "type": "string", "description": "Clinic / hospital location name" },
        "locationAddress": { "type": "string", "description": "Clinic address" },
        "city": { "type": "string", "description": "Practice city" },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 100, "description": "Patient full name" },
        "patientMobile": { "type": "string", "pattern": "^[6-9][0-9]{9}$", "description": "10-digit Indian mobile number" },
        "patientEmail": { "type": "string", "format": "email", "description": "Optional patient email" },
        "visitReason": { "type": "string", "maxLength": 300, "description": "Short visit reason or chief complaint" },
        "appointmentDate": { "type": "string", "description": "Date of appointment in YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Slot start time in HH:mm (24hr)" },
        "endTime": { "type": "string", "description": "Slot end time in HH:mm (24hr)" },
        "timeZone": { "type": "string", "description": "Timezone, e.g. Asia/Kolkata" },
        "consultationDurationMinutes": { "type": "number", "description": "Duration in minutes" },
        "consultationFee": { "type": "string", "description": "Fee in INR" },
        "status": {
          "type": "string",
          "enum": ["scheduled", "waiting", "called", "in_consultation", "completed", "cancelled", "no_show", "confirmed", "pending"],
          "description": "Status of the appointment in the queue lifecycle"
        },
        "queueStatus": {
          "type": "string",
          "enum": ["scheduled", "waiting", "called", "in_consultation", "completed", "cancelled", "no_show"],
          "description": "Granular queue state"
        },
        "tokenNumber": { "type": "number", "description": "Sequential integer queue token number" },
        "formattedToken": { "type": "string", "description": "Human-readable token display, e.g. T-01" },
        "bookingSource": {
          "type": "string",
          "enum": ["online", "walk_in_qr", "receptionist"],
          "description": "Origin of the appointment"
        },
        "slotId": { "type": "string", "description": "Deterministic slot identifier" },
        "sessionType": { "type": "string", "enum": ["session1", "session2"], "description": "OPD Consultation session identifier" },
        "checkInTime": { "type": "string", "format": "date-time", "description": "Timestamp when patient arrived at clinic" },
        "calledTime": { "type": "string", "format": "date-time", "description": "Timestamp when patient token was called" },
        "consultationStartTime": { "type": "string", "format": "date-time", "description": "Timestamp when consultation began" },
        "consultationEndTime": { "type": "string", "format": "date-time", "description": "Timestamp when consultation finished" },
        "estimatedVisitTime": { "type": "string", "description": "Estimated consultation time e.g. 11:45 AM" },
        "queueOrder": { "type": "number", "description": "Priority order index for manual reordering" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "appointmentId",
        "bookingReference",
        "doctorUid",
        "locationId",
        "patientName",
        "patientMobile",
        "appointmentDate",
        "startTime",
        "endTime",
        "consultationFee",
        "status",
        "bookingSource",
        "slotId"
      ]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "Authoritative slot reservation to prevent double-booking without exposing PII",
      "type": "object",
      "properties": {
        "slotId": { "type": "string", "description": "Deterministic ID: {locationId}_{date}_{startTime}" },
        "doctorUid": { "type": "string", "description": "Doctor UID" },
        "locationId": { "type": "string", "description": "Location ID" },
        "appointmentDate": { "type": "string", "description": "Date YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Start time HH:mm" },
        "endTime": { "type": "string", "description": "End time HH:mm" },
        "appointmentId": { "type": "string", "description": "Associated appointment ID" },
        "status": { "type": "string", "enum": ["booked", "cancelled"], "description": "Slot status" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "slotId",
        "doctorUid",
        "locationId",
        "appointmentDate",
        "startTime",
        "endTime",
        "status"
      ]
    },
    "DailyQueue": {
      "title": "DailyQueue",
      "description": "Atomic daily queue tracker and operational session status per doctor, location, and date",
      "type": "object",
      "properties": {
        "doctorUid": { "type": "string", "description": "Doctor UID" },
        "locationId": { "type": "string", "description": "Practice Location ID" },
        "date": { "type": "string", "description": "Local consultation date YYYY-MM-DD" },
        "lastTokenNumber": { "type": "number", "description": "Last sequentially allocated token number" },
        "currentServingToken": { "type": "number", "description": "Token currently inside consultation room" },
        "sessionStatus": {
          "type": "string",
          "enum": ["not_started", "active", "paused", "ended"],
          "description": "OPD doctor consultation session status"
        },
        "sessionStartTime": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "doctorUid",
        "locationId",
        "date",
        "lastTokenNumber",
        "sessionStatus"
      ]
    },
    "DoctorSubscription": {
      "title": "DoctorSubscription",
      "description": "Authoritative subscription record for an individual doctor practice",
      "type": "object",
      "properties": {
        "doctorUid": { "type": "string", "description": "Doctor user UID" },
        "planId": {
          "type": "string",
          "enum": ["monthly", "quarterly", "half_yearly", "yearly", "free_trial"],
          "description": "Subscribed plan identifier"
        },
        "status": {
          "type": "string",
          "enum": ["trialing", "active", "past_due", "expired", "cancelled", "suspended"],
          "description": "Authoritative lifecycle status"
        },
        "trialStartAt": { "type": "string", "format": "date-time", "description": "Start of free trial period" },
        "trialEndAt": { "type": "string", "format": "date-time", "description": "End of 1-month free trial period" },
        "currentPeriodStartAt": { "type": "string", "format": "date-time", "description": "Start of current billing cycle" },
        "currentPeriodEndAt": { "type": "string", "format": "date-time", "description": "Expiration date of current subscription" },
        "lastPaymentId": { "type": "string", "description": "Reference ID of latest payment" },
        "lastPaymentStatus": { "type": "string", "enum": ["captured", "failed", "pending"] },
        "lastPaymentAmountPaise": { "type": "number", "description": "Amount in integer paise" },
        "autoRenew": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "doctorUid",
        "planId",
        "status",
        "trialStartAt",
        "trialEndAt",
        "currentPeriodEndAt"
      ]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Immutable financial audit record for doctor subscription transactions",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string", "description": "Unique payment identifier" },
        "doctorUid": { "type": "string", "description": "Doctor UID" },
        "orderId": { "type": "string", "description": "Gateway order ID" },
        "planId": { "type": "string", "enum": ["monthly", "quarterly", "half_yearly", "yearly"] },
        "amountPaise": { "type": "number", "description": "Paid amount in paise" },
        "amountInr": { "type": "number", "description": "Paid amount in INR" },
        "currency": { "type": "string", "description": "Currency code e.g. INR" },
        "paymentMethod": { "type": "string", "description": "Payment instrument e.g. upi" },
        "upiApp": { "type": "string", "description": "UPI application e.g. Google Pay, PhonePe, Paytm, BHIM" },
        "vpa": { "type": "string", "description": "Masked or sanitized VPA" },
        "status": { "type": "string", "enum": ["captured", "failed", "pending"] },
        "razorpayPaymentId": { "type": "string" },
        "razorpayOrderId": { "type": "string" },
        "razorpaySignature": { "type": "string" },
        "paidAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "paymentId",
        "doctorUid",
        "orderId",
        "planId",
        "amountPaise",
        "amountInr",
        "currency",
        "paymentMethod",
        "status"
      ]
    }
  },
  "firestore": {
    "/doctors/{doctorId}": {
      "schema": "DoctorProfile",
      "description": "Multi-tenant doctor practice profile secured by doctor UID"
    },
    "/publicDoctors/{doctorId}": {
      "schema": "PublicDoctorProfile",
      "description": "Public doctor directory listing for patient discovery"
    },
    "/doctors/{doctorId}/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Private appointment records for the doctor practice"
    },
    "/doctors/{doctorId}/bookedSlots/{slotId}": {
      "schema": "BookedSlot",
      "description": "Authoritative slot reservation documents for atomic double-booking prevention"
    },
    "/doctors/{doctorId}/dailyQueues/{queueId}": {
      "schema": "DailyQueue",
      "description": "Atomic daily queue counter and operational OPD session tracking"
    },
    "/doctors/{doctorId}/subscription/{subscriptionId}": {
      "schema": "DoctorSubscription",
      "description": "Authoritative doctor subscription state and trial tracker"
    },
    "/doctors/{doctorId}/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Immutable payment audit log and UPI transactions"
    }
  }
}
