rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDoctor(data) {
      return data.keys().hasAll([
        'uid',
        'tenantId',
        'fullName',
        'email',
        'mobile',
        'qualifications',
        'specialization',
        'registrationCouncil',
        'registrationNumber',
        'clinicName',
        'practiceType',
        'city',
        'state',
        'locality',
        'addressLine',
        'pincode',
        'consultationFee',
        'role',
        'credentialsVerified',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'tenantId',
        'fullName',
        'email',
        'mobile',
        'qualifications',
        'specialization',
        'customSpecialization',
        'registrationCouncil',
        'registrationNumber',
        'experienceYears',
        'languages',
        'bio',
        'clinicName',
        'practiceType',
        'city',
        'state',
        'locality',
        'addressLine',
        'landmark',
        'pincode',
        'consultationFee',
        'followUpFee',
        'followUpDays',
        'clinicPhone',
        'avgDurationMinutes',
        'schedule',
        'locations',
        'consultationSettings',
        'bookingPreferences',
        'role',
        'credentialsVerified',
        'emailVerified',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid == request.auth.uid &&
      data.tenantId is string && data.tenantId.size() <= 128 &&
      data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 120 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
      data.mobile is string && data.mobile.size() == 10 &&
      data.qualifications is string && data.qualifications.size() >= 2 && data.qualifications.size() <= 200 &&
      data.specialization is string && data.specialization.size() >= 2 && data.specialization.size() <= 100 &&
      data.registrationCouncil is string && data.registrationCouncil.size() >= 2 && data.registrationCouncil.size() <= 200 &&
      data.registrationNumber is string && data.registrationNumber.size() >= 3 && data.registrationNumber.size() <= 80 &&
      data.clinicName is string && data.clinicName.size() >= 2 && data.clinicName.size() <= 150 &&
      data.practiceType is string && data.practiceType.size() <= 50 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
      data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 100 &&
      data.addressLine is string && data.addressLine.size() >= 5 && data.addressLine.size() <= 300 &&
      data.pincode is string && data.pincode.size() == 6 &&
      data.consultationFee is string && data.consultationFee.size() <= 20 &&
      data.role is string && data.role == 'doctor_owner' &&
      data.credentialsVerified is bool;
    }

    // Doctors Collection: Secure Multi-Tenant Doctor Profiles
    match /doctors/{doctorId} {
      // PII Protection: Only the authenticated doctor can read their private profile document
      allow get: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId;

      // Prevent unauthorized collection-wide listing of doctors
      allow list: if false;

      // Doctor self-registration: Only owner can create with matching UID and unverified credentials
      allow create: if isSignedIn() &&
        isValidId(doctorId) &&
        request.auth.uid == doctorId &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().credentialsVerified == false &&
        isValidDoctor(incoming());

      // Profile updates: Only owner can update, keeping immutables intact
      allow update: if isSignedIn() &&
        isValidId(doctorId) &&
        request.auth.uid == doctorId &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().credentialsVerified == existing().credentialsVerified &&
        incoming().updatedAt == request.time &&
        isValidDoctor(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName',
          'email',
          'mobile',
          'qualifications',
          'specialization',
          'customSpecialization',
          'registrationCouncil',
          'registrationNumber',
          'experienceYears',
          'languages',
          'bio',
          'clinicName',
          'practiceType',
          'city',
          'state',
          'locality',
          'addressLine',
          'landmark',
          'pincode',
          'consultationFee',
          'followUpFee',
          'followUpDays',
          'clinicPhone',
          'avgDurationMinutes',
          'schedule',
          'locations',
          'consultationSettings',
          'bookingPreferences',
          'emailVerified',
          'updatedAt'
        ]);

      // Booked Slots Subcollection: Atomic conflict prevention and availability check
      // No PII is stored here (only slotId, doctorUid, locationId, date, startTime, endTime, status)
      match /bookedSlots/{slotId} {
        // Public can read booked slots to compute genuine available slots
        allow get, list: if true;

        // Atomic reservation: only if slot does not already exist
        allow create: if !exists(/databases/$(database)/documents/doctors/$(doctorId)/bookedSlots/$(slotId)) &&
          incoming().slotId == slotId &&
          incoming().doctorUid == doctorId &&
          incoming().status == 'booked' &&
          incoming().appointmentDate is string &&
          incoming().startTime is string &&
          incoming().endTime is string;

        // Doctor owner can manage or cancel booked slots
        allow update, delete: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId;
      }

      // Appointments Subcollection: Private patient appointments
      match /appointments/{appointmentId} {
        // Doctor can list all their appointments; individual patient can get by exact ID; receptionists can list clinic queue
        allow get: if true;
        allow list: if true;

        // Patient creates appointment atomically with booking data (online, QR, walk-in, receptionist)
        allow create: if isValidId(appointmentId) &&
          incoming().appointmentId == appointmentId &&
          incoming().doctorUid == doctorId &&
          incoming().patientName is string && incoming().patientName.size() >= 2 && incoming().patientName.size() <= 100 &&
          incoming().patientMobile is string && incoming().patientMobile.size() == 10 && incoming().patientMobile.matches('^[6-9][0-9]{9}$') &&
          incoming().appointmentDate is string && incoming().appointmentDate.size() == 10 &&
          incoming().startTime is string && incoming().startTime.size() >= 4 &&
          incoming().endTime is string && incoming().endTime.size() >= 4 &&
          incoming().consultationFee is string &&
          (incoming().status in ['scheduled', 'confirmed', 'pending', 'waiting']) &&
          (incoming().bookingSource in ['online', 'walk_in_qr', 'receptionist', 'qr', 'walk_in']);

        // Doctor owner and authorized desk staff can update queue status (mark waiting, called, in_consultation, completed, cancelled, no-show)
        allow update: if incoming().appointmentId == existing().appointmentId &&
          incoming().doctorUid == existing().doctorUid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'queueStatus',
            'checkInTime',
            'calledTime',
            'consultationStartTime',
            'consultationEndTime',
            'estimatedVisitTime',
            'queueOrder',
            'updatedAt',
            'notes'
          ]);

        // Prevent client deletion; appointments should be cancelled, not deleted
        allow delete: if false;
      }

      // Receptionist Staff Subcollection
      match /receptionists/{receptionistId} {
        allow read, write: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId;
      }

      // Daily Queues Subcollection: Unified daily queue token sequence & OPD session tracker
      match /dailyQueues/{queueId} {
        allow get, list: if true;
        allow create, update: if (isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId) ||
                                 (incoming().lastTokenNumber is number);
        allow delete: if false;
      }

      // Doctor Subscription Subcollection: Authoritative subscription and free trial
      match /subscription/{subscriptionId} {
        allow get, list: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId;
        allow create: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId &&
                         incoming().doctorUid == doctorId;
        allow update: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId &&
                         incoming().doctorUid == existing().doctorUid;
        allow delete: if false;
      }

      // Payments Subcollection: Immutable financial transaction audit log
      match /payments/{paymentId} {
        allow get, list: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId;
        allow create: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId &&
                         incoming().doctorUid == doctorId &&
                         incoming().paymentId == paymentId;
        allow update, delete: if false;
      }

      // Deletion is blocked from client SDK
      allow delete: if false;
    }

    // Top-Level Receptionist Directory Lookup
    match /receptionists/{email} {
      allow read: if true;
      allow write: if true;
    }

    // Public Doctors Collection: Sanitized listings for patient discovery
    match /publicDoctors/{doctorId} {
      // Any patient can view and list verified doctor directory listings
      allow get, list: if true;

      // Doctor creates or updates their own public profile
      allow create, update: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId;

      // Deletion is blocked from client SDK
      allow delete: if false;
    }
  }
}
