rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDoctor(data) {
      return data.keys().hasAll([
        'uid',
        'tenantId',
        'fullName',
        'email',
        'mobile',
        'qualifications',
        'specialization',
        'registrationCouncil',
        'registrationNumber',
        'clinicName',
        'practiceType',
        'city',
        'state',
        'locality',
        'addressLine',
        'pincode',
        'consultationFee',
        'role',
        'credentialsVerified',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'tenantId',
        'fullName',
        'email',
        'mobile',
        'qualifications',
        'specialization',
        'customSpecialization',
        'registrationCouncil',
        'registrationNumber',
        'experienceYears',
        'languages',
        'bio',
        'clinicName',
        'practiceType',
        'city',
        'state',
        'locality',
        'addressLine',
        'landmark',
        'pincode',
        'consultationFee',
        'followUpFee',
        'followUpDays',
        'clinicPhone',
        'avgDurationMinutes',
        'schedule',
        'locations',
        'consultationSettings',
        'bookingPreferences',
        'role',
        'credentialsVerified',
        'emailVerified',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid == request.auth.uid &&
      data.tenantId is string && data.tenantId.size() <= 128 &&
      data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 120 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
      data.mobile is string && data.mobile.size() == 10 &&
      data.qualifications is string && data.qualifications.size() >= 2 && data.qualifications.size() <= 200 &&
      data.specialization is string && data.specialization.size() >= 2 && data.specialization.size() <= 100 &&
      data.registrationCouncil is string && data.registrationCouncil.size() >= 2 && data.registrationCouncil.size() <= 200 &&
      data.registrationNumber is string && data.registrationNumber.size() >= 3 && data.registrationNumber.size() <= 80 &&
      data.clinicName is string && data.clinicName.size() >= 2 && data.clinicName.size() <= 150 &&
      data.practiceType is string && data.practiceType.size() <= 50 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
      data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 100 &&
      data.addressLine is string && data.addressLine.size() >= 5 && data.addressLine.size() <= 300 &&
      data.pincode is string && data.pincode.size() == 6 &&
      data.consultationFee is string && data.consultationFee.size() <= 20 &&
      data.role is string && data.role == 'doctor_owner' &&
      data.credentialsVerified is bool;
    }

    // Doctors Collection: Secure Multi-Tenant Doctor Profiles
    match /doctors/{doctorId} {
      // PII Protection: Only the authenticated doctor can read their private profile document
      allow get: if isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId;

      // Prevent unauthorized collection-wide listing of doctors
      allow list: if false;

      // Doctor self-registration: Only owner can create with matching UID and unverified credentials
      allow create: if isSignedIn() &&
        isValidId(doctorId) &&
        request.auth.uid == doctorId &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().credentialsVerified == false &&
        isValidDoctor(incoming());

      // Profile updates: Only owner can update, keeping immutables intact
      allow update: if isSignedIn() &&
        isValidId(doctorId) &&
        request.auth.uid == doctorId &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().credentialsVerified == existing().credentialsVerified &&
        incoming().updatedAt == request.time &&
        isValidDoctor(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName',
          'email',
          'mobile',
          'qualifications',
          'specialization',
          'customSpecialization',
          'registrationCouncil',
          'registrationNumber',
          'experienceYears',
          'languages',
          'bio',
          'clinicName',
          'practiceType',
          'city',
          'state',
          'locality',
          'addressLine',
          'landmark',
          'pincode',
          'consultationFee',
          'followUpFee',
          'followUpDays',
          'clinicPhone',
          'avgDurationMinutes',
          'schedule',
          'locations',
          'consultationSettings',
          'bookingPreferences',
          'emailVerified',
          'updatedAt'
        ]);

      // Deletion is blocked from client SDK
      allow delete: if false;
    }

    // Public Doctors Collection: Sanitized listings for patient discovery
    match /publicDoctors/{doctorId} {
      // Any patient can view a published doctor's public profile document
      // The doctor owner can read their own document even if draft/pending
      allow get: if resource == null ||
                    (resource.data.status == 'published') ||
                    (isSignedIn() && isValidId(doctorId) && request.auth.uid == doctorId);

      // Public directory listing: Only published profiles can be listed or queried
      // Queries must include where('status', '==', 'published') to satisfy this rule
      allow list: if resource.data.status == 'published';

      // Doctor creates their public profile
      allow create: if isSignedIn() &&
        isValidId(doctorId) &&
        request.auth.uid == doctorId &&
        incoming().doctorUid == request.auth.uid &&
        incoming().credentialsVerified == false &&
        (incoming().status in ['draft', 'pending_review', 'published']) &&
        incoming().fullName is string && incoming().fullName.size() >= 3 &&
        incoming().specialization is string &&
        incoming().city is string &&
        incoming().primaryClinicName is string &&
        incoming().consultationFee is string;

      // Doctor updates their public profile: Credential verification remains immutable
      allow update: if isSignedIn() &&
        isValidId(doctorId) &&
        request.auth.uid == doctorId &&
        incoming().doctorUid == existing().doctorUid &&
        incoming().credentialsVerified == existing().credentialsVerified &&
        (incoming().status in ['draft', 'pending_review', 'published', 'suspended']) &&
        incoming().fullName is string && incoming().fullName.size() >= 3 &&
        incoming().specialization is string &&
        incoming().city is string &&
        incoming().primaryClinicName is string &&
        incoming().consultationFee is string;

      // Deletion is denied; doctor sets status to 'draft' or 'suspended' to unpublish
      allow delete: if false;
    }
  }
}
